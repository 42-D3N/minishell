{
	ignore_libreadline_leak
	Memcheck:Leak
	...
	obj:*/usr/lib/*libreadline.so*
}
{
	readline_malloc
	Memcheck:Leak
	match-leak-kinds: reachable
	fun:xrealloc
	fun:???
	fun:rl_expand_prompt
	fun:readline
}
{
	ignore_libreadline_leaks
	Memcheck:Leak
	match-leak-kinds: reachable
	...
	obj:*/libreadline.so.*
}
{
	std
	Memcheck:Leak
	...
	obj:*/bin/*
}
